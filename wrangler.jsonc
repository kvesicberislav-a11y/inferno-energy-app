// Postavke za objavu na Cloudflare Workers (preko OpenNext).
// Tajne vrijednosti NE idu ovdje – upisuju se u Cloudflare nadzornoj ploči.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inferno-energy-app",
  // worker.mjs = Next.js aplikacija (.open-next/worker.js) + dnevno održavanje (cron ispod)
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "inferno-energy-app"
    }
  ],
  // Spremište za dnevne sigurnosne kopije baze (Cloudflare KV, besplatno do 1 GB).
  "kv_namespaces": [
    {
      "binding": "KOPIJE",
      "id": "10a195615806466080fa9b0effcc07c6"
    }
  ],
  // Dnevno održavanje u 02:15 UTC (03:15 zimi / 04:15 ljeti po zagrebačkom vremenu).
  "triggers": {
    "crons": ["15 2 * * *"]
  },
  // workers.dev adresa ostaje uključena (stara adresa preusmjerava na infernoenergy.hr),
  // a preview_urls daje testnu adresu: test-inferno-energy-app.kvesic-berislav.workers.dev
  // (npm run test-verzija – učita probnu verziju bez objave klijentima).
  "workers_dev": true,
  "preview_urls": true,
  // Prava adresa aplikacije (DNS zona infernoenergy.hr je u Cloudflareu). www preusmjerava na glavnu (worker.mjs).
  "routes": [
    { "pattern": "infernoenergy.hr", "custom_domain": true },
    { "pattern": "www.infernoenergy.hr", "custom_domain": true }
  ],
  // Ne briši varijable upisane u nadzornoj ploči pri svakoj objavi.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
