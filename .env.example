# Predložak. Pravi ključevi idu u datoteku .env.local (ona se NIKAD ne šalje na GitHub).
# Vrijednosti nađete u Supabaseu: Project Settings -> API Keys (i Data API za URL).

# Adresa Supabase projekta, npr. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Javni ključ (počinje sa sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TAJNI ključ (počinje sa sb_secret_) – nikad ga nikome ne šaljite
SUPABASE_SECRET_KEY=

# Obavijesti na mobitel: javni kljuc (ovdje) + tajni VAPID_PRIVATE_JWK (samo Cloudflare tajna)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
